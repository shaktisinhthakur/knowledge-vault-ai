@model DocumentDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="glass-card p-5 mb-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
                <div>
                    <span class="badge bg-secondary mb-2">@Model.CategoryName</span>
                    <h3 class="fw-bold mb-0">@Model.Title</h3>
                </div>
                <div class="d-flex gap-2">
                    @if (!Model.IsEmbedded)
                    {
                        <form asp-action="Embed" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-accent">
                                <i class="bi bi-stars me-2"></i>Embed Chunks
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-success p-2 d-flex align-items-center gap-1">
                            <i class="bi bi-check-circle-fill"></i> Embedded &amp; Active
                        </span>
                    }
                </div>
            </div>

            <h5 class="fw-bold mb-3 border-bottom border-dark pb-2">Document Content</h5>
            <div class="text-light-grey pre-wrap" style="line-height:1.7;">
                @Model.Content
            </div>

            <div class="d-flex gap-3 mt-5">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to Documents
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-2"></i>Delete
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Chunks Metadata Card -->
        <div class="glass-card p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-puzzle-fill me-2 text-accent"></i>Document Chunks</h5>
            <p class="text-secondary small">
                This document is split into @Model.ChunkCount semantic chunk(s) for vector indexing.
            </p>
            <div class="list-group list-group-flush border-top border-dark">
                @for (int i = 1; i <= Model.ChunkCount; i++)
                {
                    <div class="list-group-item bg-transparent text-light border-dark py-3 px-0">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-accent small">Chunk #@i</span>
                            @if (Model.IsEmbedded)
                            {
                                <span class="badge bg-success-subtle text-success small">Indexed</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning small">Pending</span>
                            }
                        </div>
                        <p class="text-secondary small mb-0 text-truncate-2">
                            Chunk content automatically managed on server side.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
