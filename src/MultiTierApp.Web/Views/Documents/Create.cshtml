@model DocumentDto
@{
    ViewData["Title"] = "New Document";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-5">
            <h3 class="fw-bold mb-4"><i class="bi bi-file-earmark-plus me-2 text-accent"></i>Add Document</h3>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-alert" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-medium">Document Title</label>
                    <input asp-for="Title" class="form-control form-control-dark" placeholder="e.g., API Rate Limits and Authentication" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CategoryId" class="form-label fw-medium">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select form-select-dark">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-medium">Content / Body Text</label>
                    <textarea asp-for="Content" class="form-control form-control-dark" rows="10" placeholder="Paste document content here. It will automatically be split into semantic chunks for vector search."></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Source" class="form-label fw-medium">Source / Reference</label>
                    <input asp-for="Source" class="form-control form-control-dark" placeholder="e.g., wiki, manual, uploaded" />
                    <span asp-validation-for="Source" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-accent">
                        <i class="bi bi-check-circle me-2"></i>Save Document
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
