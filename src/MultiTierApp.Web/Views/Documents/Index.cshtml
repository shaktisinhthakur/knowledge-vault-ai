@model IEnumerable<DocumentDto>
@{
    ViewData["Title"] = "Documents";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-text-fill me-2 text-accent"></i>Documents</h2>
        <p class="text-secondary mb-0">Manage knowledge base sources and document chunks</p>
    </div>
    <a asp-action="Create" class="btn btn-accent">
        <i class="bi bi-plus-circle-fill me-2"></i>Add Document
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var doc in Model)
        {
            <div class="col-md-6">
                <div class="glass-card p-4 h-100 card-hover d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-secondary">@doc.CategoryName</span>
                            @if (doc.IsEmbedded)
                            {
                                <span class="badge bg-success-subtle text-success">
                                    <i class="bi bi-check-circle-fill me-1"></i>Embedded
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning">
                                    <i class="bi bi-exclamation-circle me-1"></i>Requires Embedding
                                </span>
                            }
                        </div>
                        <h5 class="fw-bold mb-2">@doc.Title</h5>
                        <p class="text-secondary small mb-3 text-truncate-3">
                            @doc.Content
                        </p>
                    </div>
                    <div class="pt-3 border-top border-dark d-flex justify-content-between align-items-center mt-3">
                        <span class="text-secondary small">
                            <i class="bi bi-puzzle me-1"></i>@doc.ChunkCount chunks
                        </span>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-light">
                                <i class="bi bi-eye me-1"></i> View
                            </a>
                            <a asp-action="Delete" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-file-earmark-plus" style="font-size: 3rem;" class="text-secondary"></i>
        <p class="mt-3 text-secondary">No documents found. Start by uploading one!</p>
        <a asp-action="Create" class="btn btn-accent">
            <i class="bi bi-plus-circle me-2"></i>Add Document
        </a>
    </div>
}
