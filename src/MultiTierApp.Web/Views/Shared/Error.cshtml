@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <div class="glass-card p-5">
        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
        <h1 class="mt-3 fw-bold">Oops! Something went wrong</h1>
        <p class="text-secondary mt-3">An unexpected error occurred. Please try again later.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-accent mt-3">
            <i class="bi bi-house-fill me-2"></i>Back to Dashboard
        </a>
    </div>
</div>
