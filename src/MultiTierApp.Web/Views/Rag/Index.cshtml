@{
    ViewData["Title"] = "Ask AI Assistant";
}

<div class="row g-4 chat-container-row">
    <!-- Chat Interface -->
    <div class="col-lg-8 d-flex flex-column">
        <div class="glass-card p-4 chat-card flex-grow-1 d-flex flex-column">
            <!-- Chat Header -->
            <div class="d-flex align-items-center justify-content-between mb-4 border-bottom border-dark pb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-icon" style="width:40px;height:40px;font-size:1.1rem;border-radius:10px;">
                        <i class="bi bi-stars"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Ask AI Assistant</h5>
                        <p class="text-secondary small mb-0">Retrieve context from your knowledge base</p>
                    </div>
                </div>
                <button id="clearChatBtn" class="btn btn-sm btn-outline-secondary" title="Clear Chat">
                    <i class="bi bi-trash3-fill"></i> Clear
                </button>
            </div>

            <!-- Chat Messages Scroll Area -->
            <div id="chatMessages" class="chat-messages flex-grow-1 overflow-y-auto mb-4 px-2">
                <!-- Welcome Message -->
                <div class="message-wrapper assistant">
                    <div class="message-icon">
                        <i class="bi bi-stars"></i>
                    </div>
                    <div class="message-bubble">
                        Hello! I am your Retrieval-Augmented Generation (RAG) assistant. 
                        Ask me anything about the documents you've uploaded and embedded. 
                        I'll retrieve relevant sections and answer using Groq AI.
                    </div>
                </div>
            </div>

            <!-- Input area -->
            <form id="chatForm" class="chat-input-form mt-auto">
                <div class="input-group">
                    <input type="text" id="userInput" class="form-control form-control-dark" 
                           placeholder="Ask a question about your documents..." required autocomplete="off" />
                    <button type="submit" id="sendBtn" class="btn btn-accent px-4">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Citations and Sources Panel -->
    <div class="col-lg-4">
        <div class="glass-card p-4 h-100 d-flex flex-column">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-quote me-2 text-accent"></i>Sources &amp; References
            </h5>
            <p class="text-secondary small mb-4">
                The references retrieved by the vector search for the last query will be shown below.
            </p>

            <div id="sourcesContainer" class="flex-grow-1 overflow-y-auto" style="max-height: 480px;">
                <div class="text-center text-secondary py-5">
                    <i class="bi bi-search" style="font-size: 2rem;"></i>
                    <p class="mt-3 small">Ask a question to see semantic search results.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Store any page-specific initial state if needed
    </script>
}
