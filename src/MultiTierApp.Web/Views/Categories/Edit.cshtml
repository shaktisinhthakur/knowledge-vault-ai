@model CategoryDto
@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="glass-card p-5">
            <h3 class="fw-bold mb-4"><i class="bi bi-pencil-square me-2 text-accent"></i>Edit Category</h3>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger glass-alert" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-medium">Category Name</label>
                    <input asp-for="Name" class="form-control form-control-dark" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-medium">Description</label>
                    <textarea asp-for="Description" class="form-control form-control-dark" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="IconClass" class="form-label fw-medium">Icon</label>
                    <input asp-for="IconClass" class="form-control form-control-dark" />
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-accent">
                        <i class="bi bi-check-circle me-2"></i>Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
